# Copy to .env and adjust. All settings use the RAG_ prefix.
# Relative paths are resolved from the project root.

RAG_LOG_LEVEL=INFO

# --- Query pipeline (Pipeline 2, steps 1-14) ---
# Local generator (llama.cpp OpenAI-compatible server, see scripts/serve_llm.ps1)
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_LLM_MODEL=qwen3.5-9b-local
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_MAX_TOKENS=512
RAG_LLM_TIMEOUT_S=180
RAG_LLM_ENABLE_THINKING=false
# llama.cpp prefix/KV cache. Hits are reported per answer in
# generation.cached_tokens / cache_hit_rate. Set false only for A/B benchmarks.
RAG_LLM_CACHE_PROMPT=true

# Query rewriting (step 5; set false for a zero-LLM rewrite baseline)
RAG_REWRITE_ENABLED=true
RAG_REWRITE_MAX_TOKENS=96
RAG_REWRITE_MAX_CHARS=400
RAG_REWRITE_HISTORY_TURNS=4

# Input guardrail (step 3).
# models/llama-prompt-guard-2 is the verified binary Prompt Guard 2 checkpoint.
# The older models/llama-prompt-guard-2-86m directory contains Prompt Guard 1.
RAG_GUARD_ENABLED=true
RAG_GUARD_MODEL_DIR=models/llama-prompt-guard-2
RAG_GUARD_DEVICE=cpu
RAG_GUARD_THRESHOLD=0.5
RAG_GUARD_BLOCK_PII=false

# Rate limiting (per user, per minute)
RAG_RATE_LIMIT_PER_MINUTE=60
RAG_RATE_LIMIT_BURST=20

# Encoder (must match ingestion exactly)
RAG_MODEL_DIR=models/bge-large-en-v1.5
RAG_VECTOR_DIM=1024
RAG_EMBED_DEVICE=cuda
RAG_EMBED_BATCH_SIZE=32
RAG_EMBED_USE_FP16=true
RAG_MODEL_MAX_SEQ_LENGTH=512

# Index compatibility. The full-table probe runs once at startup and is cached;
# retrieval also filters on model_id + dim on every query.
RAG_VECTOR_CHECK=true
RAG_VECTOR_CHECK_AT_STARTUP=true
RAG_VECTOR_PROBE_TTL_S=300

# --- Step 8: hybrid retrieval ---
RAG_RETRIEVAL_ENABLED=true
RAG_RETRIEVAL_DENSE_K=50
RAG_RETRIEVAL_LEXICAL_K=50
RAG_RETRIEVAL_FUSED_K=40
RAG_RETRIEVAL_PER_COMPANY_K=8
RAG_RETRIEVAL_RRF_K=60
RAG_RETRIEVAL_DENSE_WEIGHT=1.0
RAG_RETRIEVAL_LEXICAL_WEIGHT=0.8
RAG_RETRIEVAL_LEXICAL_MIN_HITS=8
RAG_RETRIEVAL_LEXICAL_MAX_TERMS=8
RAG_RETRIEVAL_STATEMENT_TIMEOUT_MS=15000
RAG_RETRIEVAL_HNSW_EF_SEARCH=100
RAG_RETRIEVAL_HNSW_ITERATIVE_SCAN=true
RAG_RETRIEVAL_NEIGHBOR_WINDOW=1
RAG_CORPUS_YEARS='["2020"]'

# Company-name -> CIK filters. Optional; run scripts/download_company_tickers.py.
RAG_COMPANY_MAP_PATH=data/company_tickers.json

# Qwen3 cross-encoder rerank. On the reference laptop, 8-16 candidates take
# roughly 0.7-2.3s alongside the resident 9B LLM. Keep this on cuda; if it
# cannot fit, the pipeline keeps retrieval order instead of using the
# ~9s/candidate CPU path.
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL_DIR=models/Qwen3-Reranker-0.6B
RAG_RERANK_DEVICE=cuda
RAG_RERANK_BATCH_SIZE=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_TOP_K=8
RAG_RERANK_ALLOW_CPU_FALLBACK=false

# --- Step 10: deterministic context builder ---
RAG_CONTEXT_TOKEN_BUDGET=6500
RAG_CONTEXT_MAX_SOURCES=12
RAG_CONTEXT_MAX_HISTORY_MESSAGES=6
RAG_CONTEXT_INCLUDE_HISTORY=false
RAG_CONTEXT_CHARS_PER_TOKEN=4.0
RAG_CONTEXT_MIN_SOURCE_TOKENS=60
RAG_CONTEXT_HISTORY_BUDGET_RATIO=0.2
RAG_CONTEXT_TOKENIZER_DIR=models/Qwen3-Reranker-0.6B

# --- Step 11: grounded generation ---
RAG_GENERATION_TEMPERATURE=0.1
RAG_GENERATION_MAX_TOKENS=768
RAG_GENERATION_MAX_RETRIES=1
RAG_GENERATION_RETRY_SLEEP_S=0.5

# --- Step 12: output guard ---
RAG_OUTPUT_GUARD_ENABLED=true
RAG_OUTPUT_GUARD_MIN_CITATIONS=1
RAG_OUTPUT_GUARD_GROUNDING_THRESHOLD=0.45
RAG_OUTPUT_GUARD_GROUNDING_MIN_RATIO=0.6
RAG_OUTPUT_GUARD_MAX_RETRIES=1
RAG_OUTPUT_GUARD_PII_BLOCK=true

# --- Step 14: conversation history and feedback ---
RAG_HISTORY_ENABLED=true
RAG_HISTORY_MAX_TURNS=6
RAG_HISTORY_PERSIST_FAILURES=true
RAG_FEEDBACK_ADMIN_GROUP=admin

# --- Postgres (system of record: documents, chunks, embeddings, turns) ---
RAG_POSTGRES_DSN=postgresql+psycopg://rag:rag@localhost:5432/rag
RAG_DB_CONNECT_TIMEOUT_S=5

# --- Ingestion (Pipeline 1) ---
RAG_DATASET_DIR=dataset
RAG_EDGAR_REPO_ID=eloukas/edgar-corpus
RAG_EDGAR_YEAR=2020
RAG_CHUNK_TARGET_TOKENS=384
RAG_CHUNK_OVERLAP_TOKENS=48
RAG_CHUNK_MAX_TOKENS=500
